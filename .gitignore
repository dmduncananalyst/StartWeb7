
# Private translation checkpoints and locks; permanent releases remain reviewable.
.translation-cache/
**/__pycache__/

# Temporary browser profiles generated by local website audits.
/verification/full-frame/chrome-profile-*/

# Generated audit output stays local. Keep text reports, approved-content
# records, page inventories and intentionally versioned JSON evidence.
/verification/**/chrome-profile-*/
/verification/**/*.png
/verification/**/*.jpg
/verification/**/*.jpeg
/verification/**/*.webp
/verification/**/*.mp4
/verification/**/*.webm
/verification/**/*.log
/verification/**/error.txt
/verification/**/*-log.txt
/verification/**/trace*.json
/verification/**/temp*.json
/verification/**/tmp*/
/verification/**/traces/
/verification/**/videos/
/debug.log
/test-results/
/playwright-report/
